{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/laporan-otomatis",
      "dest": "/api/laporan-otomatis.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/laporan-otomatis",
      "schedule": "0 1 1 * *"
    }
  ]
}
